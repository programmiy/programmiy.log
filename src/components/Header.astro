---
import { SITE_CONFIG } from '../config';
import { getUrl } from '../utils/url';
---

<header class="sticky top-0 z-40 w-full backdrop-blur border-b border-velog-light-border dark:border-velog-dark-border bg-white/80 dark:bg-velog-dark-bg/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={getUrl('/')} class="flex items-center gap-2 group">
      <span
        class="text-[1.3125rem] font-bold text-velog-light-text1 dark:text-velog-dark-text1 group-hover:text-velog-green transition-colors font-logo tracking-tight"
        style="font-family: 'Courier New', 'Courier Prime', Courier, monospace !important; font-weight: 700 !important;"
      >
        {SITE_CONFIG.title}
      </span>
    </a>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2 text-velog-light-text3 dark:text-velog-dark-text3 hover:text-velog-green dark:hover:text-velog-green rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        aria-label="Toggle dark mode"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>

      <!-- GitHub Link -->
      <a
        href={SITE_CONFIG.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-velog-light-text3 dark:text-velog-dark-text3 hover:text-velog-light-text1 dark:hover:text-white rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        aria-label="GitHub Repository"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>

      <!-- Sveltia CMS Admin Link (벨로그 새 글 작성 버튼 느낌) -->
      <a
        href={getUrl('/admin')}
        class="hidden sm:inline-flex items-center px-3.5 py-1.5 text-sm font-semibold rounded-full border border-velog-light-text1 dark:border-velog-dark-text1 hover:bg-velog-light-text1 hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"
      >
        새 글 작성
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');

  function updateIcons() {
    if (document.documentElement.classList.contains('dark')) {
      themeToggleLightIcon?.classList.remove('hidden');
      themeToggleDarkIcon?.classList.add('hidden');
    } else {
      themeToggleDarkIcon?.classList.remove('hidden');
      themeToggleLightIcon?.classList.add('hidden');
    }
  }

  updateIcons();

  themeToggleBtn?.addEventListener('click', () => {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateIcons();

    // Giscus 다크모드 테마 동기화 메시지 브로드캐스트
    const iframe = document.querySelector('iframe.giscus-frame');
    if (iframe) {
      const isDark = document.documentElement.classList.contains('dark');
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: isDark ? 'dark' : 'light' } } },
        'https://giscus.app'
      );
    }
  });
</script>
