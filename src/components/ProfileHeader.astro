---
import { SITE_CONFIG } from '../config';
import { getUrl } from '../utils/url';

export interface Props {
  activeTab?: 'posts' | 'series' | 'about';
}

const { activeTab = 'posts' } = Astro.props;
---

<div class="pt-8 pb-4">
  <!-- Profile Info -->
  <div class="flex items-center gap-6 mb-8">
    <!-- Profile Avatar -->
    <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full overflow-hidden bg-velog-green/10 flex items-center justify-center shrink-0 border-2 border-velog-light-border dark:border-velog-dark-border shadow-sm">
      <div class="text-3xl sm:text-4xl font-extrabold text-velog-green font-mono uppercase">
        {SITE_CONFIG.author.slice(0, 2)}
      </div>
    </div>

    <!-- User Details -->
    <div class="flex-1 min-w-0">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-velog-light-text1 dark:text-velog-dark-text1 tracking-tight">
        {SITE_CONFIG.author}
      </h1>
      <p class="text-sm sm:text-base text-velog-light-text2 dark:text-velog-dark-text2 mt-1.5 line-clamp-2 leading-relaxed">
        {SITE_CONFIG.bio}
      </p>

      <!-- Social Links -->
      <div class="flex items-center gap-3 mt-3 text-velog-light-text3 dark:text-velog-dark-text3">
        {SITE_CONFIG.githubUrl && (
          <a
            href={SITE_CONFIG.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-velog-light-text1 dark:hover:text-white transition-colors"
            title="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </a>
        )}
        {SITE_CONFIG.email && (
          <a
            href={SITE_CONFIG.email}
            class="hover:text-velog-light-text1 dark:hover:text-white transition-colors"
            title="Email"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="h-px bg-velog-light-border dark:bg-velog-dark-border w-full mb-6"></div>

  <!-- Velog Tabs ([글], [시리즈], [소개]) -->
  <nav class="flex items-center gap-8 text-lg font-semibold border-b border-velog-light-border dark:border-velog-dark-border">
    <a
      href={getUrl('/')}
      class={`pb-3 relative transition-colors ${
        activeTab === 'posts'
          ? 'text-velog-green font-bold'
          : 'text-velog-light-text3 dark:text-velog-dark-text3 hover:text-velog-light-text1 dark:hover:text-velog-dark-text1'
      }`}
    >
      글
      {activeTab === 'posts' && (
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-velog-green"></span>
      )}
    </a>

    <a
      href={getUrl('/series')}
      class={`pb-3 relative transition-colors ${
        activeTab === 'series'
          ? 'text-velog-green font-bold'
          : 'text-velog-light-text3 dark:text-velog-dark-text3 hover:text-velog-light-text1 dark:hover:text-velog-dark-text1'
      }`}
    >
      시리즈
      {activeTab === 'series' && (
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-velog-green"></span>
      )}
    </a>

    <a
      href={getUrl('/about')}
      class={`pb-3 relative transition-colors ${
        activeTab === 'about'
          ? 'text-velog-green font-bold'
          : 'text-velog-light-text3 dark:text-velog-dark-text3 hover:text-velog-light-text1 dark:hover:text-velog-dark-text1'
      }`}
    >
      소개
      {activeTab === 'about' && (
        <span class="absolute bottom-0 left-0 w-full h-[2px] bg-velog-green"></span>
      )}
    </a>
  </nav>
</div>
