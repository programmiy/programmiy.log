---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_CONFIG } from '../config';
import { getUrl } from '../utils/url';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
}

const { title, description, image, articleDate } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={title} description={description} image={image} articleDate={articleDate} />
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <Header />

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-6">
      <slot />
    </main>

    <footer class="mt-20 border-t border-velog-light-border dark:border-velog-dark-border py-8 text-center text-xs text-velog-light-text3 dark:text-velog-dark-text3">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
        <div>
          © {new Date().getFullYear()} {SITE_CONFIG.author}. Powered by <a href="https://astro.build" target="_blank" class="hover:underline">Astro</a> & <a href="https://github.com/sveltia/sveltia-cms" target="_blank" class="hover:underline">Sveltia CMS</a>.
        </div>
        <div class="flex items-center gap-4">
          <a href={getUrl('/admin')} class="hover:text-velog-green">Admin</a>
          <a href={getUrl('/rss.xml')} class="hover:text-velog-green">RSS</a>
          <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-velog-green">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
