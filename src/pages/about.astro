---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import { SITE_CONFIG } from '../config';
---

<BaseLayout title={`소개 | ${SITE_CONFIG.title}`} description={`${SITE_CONFIG.author} 소개`}>
  <ProfileHeader activeTab="about" />

  <div class="max-w-2xl mx-auto py-12">
    <div class="prose prose-lg dark:prose-invert">
      <h2>안녕하세요, {SITE_CONFIG.author}입니다. 👋</h2>
      <p>
        {SITE_CONFIG.bio}
      </p>

      <hr />

      <h3>관심사 및 개발 분야</h3>
      <ul>
        <li>인공지능(AI) 기반 번역 및 자동화 프로젝트</li>
        <li>바이브 코딩 및 최신 프론트엔드/백엔드 기술 스택 탐구</li>
        <li>GPU/CUDA 가속 및 고성능 연산 시스템 학습</li>
      </ul>

      <h3>Links & Contact</h3>
      <ul>
        <li>
          <strong>GitHub:</strong>{' '}
          <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer">
            {SITE_CONFIG.githubUrl}
          </a>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>
