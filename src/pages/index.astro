---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import TagSidebar from '../components/TagSidebar.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_CONFIG } from '../config';

// 최신순으로 포스트 정렬 (draft 제외)
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// 태그 통계 집계
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));
---

<BaseLayout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <!-- Profile & 3 Navigation Tabs -->
  <ProfileHeader activeTab="posts" />

  <div class="mt-8 flex flex-col lg:flex-row gap-8 items-start">
    <!-- Tag Filter Sidebar -->
    <TagSidebar tags={sortedTags} totalPosts={posts.length} />

    <!-- Main Posts Content Area -->
    <div class="flex-1 min-w-0 w-full">
      <!-- Inline Search Input -->
      <div class="relative mb-6">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-velog-light-text3 dark:text-velog-dark-text3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          id="post-search-input"
          type="text"
          placeholder="포스트 제목, 요약, 태그 검색..."
          class="w-full pl-10 pr-4 py-2.5 rounded-lg text-sm bg-white dark:bg-velog-dark-card border border-velog-light-border dark:border-velog-dark-border focus:outline-none focus:border-velog-green dark:focus:border-velog-green transition-colors text-velog-light-text1 dark:text-velog-dark-text1 placeholder-velog-light-text3 dark:placeholder-velog-dark-text3 shadow-sm"
        />
      </div>

      <!-- Posts List -->
      <div id="posts-container" class="space-y-6">
        {posts.map((post) => (
          <div
            class="post-item"
            data-title={post.data.title.toLowerCase()}
            data-description={post.data.description.toLowerCase()}
            data-tags={(post.data.tags || []).join(' ').toLowerCase()}
          >
            <PostCard post={post} />
          </div>
        ))}
      </div>

      <!-- No search results message -->
      <div id="no-search-results" class="hidden text-center py-16 text-velog-light-text3 dark:text-velog-dark-text3">
        <p class="text-base font-semibold">검색 결과가 없습니다.</p>
        <p class="text-sm mt-1">다른 검색어를 입력해 보세요.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('post-search-input');
  const postItems = document.querySelectorAll('.post-item');
  const noResults = document.getElementById('no-search-results');

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.trim().toLowerCase();
    let visibleCount = 0;

    postItems.forEach((item) => {
      const title = item.getAttribute('data-title') || '';
      const desc = item.getAttribute('data-description') || '';
      const tags = item.getAttribute('data-tags') || '';

      if (!query || title.includes(query) || desc.includes(query) || tags.includes(query)) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (visibleCount === 0 && query !== '') {
      noResults?.classList.remove('hidden');
    } else {
      noResults?.classList.add('hidden');
    }
  });
</script>
